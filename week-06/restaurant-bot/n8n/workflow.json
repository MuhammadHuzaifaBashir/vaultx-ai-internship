{
  "name": "SpiceRoute Restaurant Automation",
  "nodes": [
    {
      "parameters": {
        "path": "restaurant-webhook",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "WhatsApp Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "id": "rest-webhook-id",
      "webhookId": "restaurant-webhook"
    },
    {
      "parameters": {
        "model": "models/gemini-3.5-flash-lite",
        "options": {"temperature": 0.7},
        "text": "={{ $json.message }}\n\nYou are the AI assistant for SpiceRoute Restaurant in Lahore, Pakistan. Help customers order food, answer menu questions, and confirm orders. If the message indicates an order, extract the items, customer name, phone, and address. If the message asks about order status, look up the order ID.",
        "promptType": "define"
      },
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [300, 0],
      "id": "rest-ai-id",
      "credentials": {
        "googleGeminiApi": {
          "id": "google-gemini-1",
          "name": "Google Gemini Api"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const items = $input.all();\nconst data = items[0].json;\n\n// Determine if this is an order or a chat message\nconst orderKeywords = ['order', 'want', 'need', 'book', 'deliver', 'i want', 'i would like', 'can i have'];\nconst msg = (data.message || '').toLowerCase();\nconst isOrder = orderKeywords.some(kw => msg.includes(kw));\nconst isStatus = msg.includes('status') || msg.includes('track') || msg.includes('where');\nconst isCancel = msg.includes('cancel') || msg.includes('remove');\nconst isMenu = msg.includes('menu') || msg.includes('show menu');\n\nconst orderType = isOrder ? 'order' : isStatus ? 'status' : isCancel ? 'cancel' : isMenu ? 'menu' : 'chat';\n\nreturn [{\n  json: {\n    ...data,\n    orderType: orderType,\n    orderId: data.order_id || null,\n    items: data.items || [],\n    name: data.name || data.customer_name || 'Customer',\n    phone: data.phone || '+923****0000',\n    total: data.total || 0,\n    address: data.address || '',\n  }\n}];"
      },
      "name": "Route Order Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 0],
      "id": "rest-route-id"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v18.0/1268258293044883/messages",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "messaging_product", "value": "whatsapp"},
            {"name": "to", "value": "={{ $json.phone }}"},
            {"name": "type", "value": "text"},
            {"name": "text", "value": "🌟 *Order Confirmed!*\\n\\nCustomer: {{ $json.name }}\\nItems: {{ $json.items.join('\\n') }}\\nTotal: PKR {{ $json.total }}\\n\\nThank you for ordering at SpiceRoute! 🍽️\\nDelivery: 30-45 minutes.\\nTrack your order anytime by texting 'status ORD-XXX'"}
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "Send Customer Confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, -150],
      "id": "rest-confirm-id"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v18.0/1268258293044883/messages",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "messaging_product", "value": "whatsapp"},
            {"name": "to", "value": "{{ $json.adminPhone || '+923****4567' }}"},
            {"name": "type", "value": "text"},
            {"name": "text", "value": "🔔 NEW ORDER from SpiceRoute\\nCustomer: {{ $json.name }}\\nPhone: {{ $json.phone }}\\nItems: {{ $json.items.join(', ') }}\\nTotal: PKR {{ $json.total }}\\nAddress: {{ $json.address || 'N/A' }}\\nStatus: NEW"}
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "Notify Owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 150],
      "id": "rest-notify-id"
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "days"
      },
      "name": "Wait 2 Days",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1200, 0],
      "id": "rest-wait-id"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v18.0/1268258293044883/messages",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "messaging_product", "value": "whatsapp"},
            {"name": "to", "value": "={{ $json.phone }}"},
            {"name": "type", "value": "text"},
            {"name": "text", "value": "Hi {{ $json.name }}! 😊\\nHope you enjoyed your meal at SpiceRoute! 🍽️\\nWant to order again? Just text us! 🔥\\nSpecial today: Try our new Mutton Biryani! 🌶️"}
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "Send Follow-Up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 0],
      "id": "rest-followup-id"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v18.0/1268258293044883/messages",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "messaging_product", "value": "whatsapp"},
            {"name": "to", "value": "={{ $json.phone }}"},
            {"name": "type", "value": "text"},
            {"name": "text", "value": "={{ $json.aiResponse || 'Thanks for contacting SpiceRoute! How can I help you?' }}"}
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "Send Chat Response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "id": "rest-chat-response-id"
    },
    {
      "parameters": {
        "responseCode": 200,
        "responseData": "{\"status\":\"received\",\"orderId\":\"pending\"}",
        "responseType": "json"
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [600, 300],
      "id": "rest-respond-id"
    },
    {
      "parameters": {
        "model": "models/gemini-3.5-flash-lite",
        "options": {"temperature": 0.3},
        "text": "={{ \"Check the status of order: \" + $json.orderId + \"\\n\\nReturn ONLY the status (pending/confirmed/preparing/ready/on_the_way/delivered/cancelled) and a brief 2-sentence update. Be concise.\" }}",
        "promptType": "define"
      },
      "name": "Order Status Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [600, -300],
      "id": "rest-status-agent-id",
      "credentials": {
        "googleGeminiApi": {
          "id": "google-gemini-1",
          "name": "Google Gemini Api"
        }
      }
    }
  ],
  "connections": {
    "WhatsApp Webhook": {
      "main": [
        [{"node": "AI Agent", "type": "main", "index": 0}],
        [{"node": "Respond to Webhook", "type": "main", "index": 0}]
      ]
    },
    "AI Agent": {
      "main": [
        [{"node": "Route Order Type", "type": "main", "index": 0}]
      ]
    },
    "Route Order Type": {
      "main": [
        [{"node": "Send Customer Confirmation", "type": "main", "index": 0}],
        [{"node": "Notify Owner", "type": "main", "index": 0}],
        [{"node": "Order Status Agent", "type": "main", "index": 0}],
        [{"node": "Send Chat Response", "type": "main", "index": 0}]
      ]
    },
    "Send Customer Confirmation": {
      "main": [[{"node": "Notify Owner", "type": "main", "index": 0}]]
    },
    "Notify Owner": {
      "main": [[{"node": "Wait 2 Days", "type": "main", "index": 0}]]
    },
    "Wait 2 Days": {
      "main": [[{"node": "Send Follow-Up", "type": "main", "index": 0}]]
    },
    "Order Status Agent": {
      "main": [[{"node": "Send Chat Response", "type": "main", "index": 0}]]
    },
    "Send Chat Response": {
      "main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]
    },
    "Send Follow-Up": {
      "main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]
    },
    "Respond to Webhook": {
      "main": []
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": true,
    "saveDataErrorExecution": true
  },
  "id": "spiceroute-automation-v2"
}