{
  "name": "Restaurant Follow-Up Automation",
  "nodes": [
    {
      "parameters": {
        "path": "restaurant-webhook",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "WhatsApp Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "id": "rest-webhook-id",
      "webhookId": "restaurant-webhook"
    },
    {
      "parameters": {
        "model": "models/gemini-3.5-flash-lite",
        "options": {
          "temperature": 0.7
        },
        "text": "={{ $json.message }}\n\nYou are a restaurant assistant for SpiceRoute Restaurant. Help customers order food, answer menu questions, and confirm orders.",
        "promptType": "define"
      },
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        300,
        0
      ],
      "id": "rest-ai-id",
      "credentials": {
        "googleGeminiApi": {
          "id": "google-gemini-1",
          "name": "Google Gemini Api"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v18.0/1268258293044883/messages",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "to",
              "value": "={{ $json.ownerPhone || '+923****3411' }}"
            },
            {
              "name": "type",
              "value": "text"
            },
            {
              "name": "text",
              "value": "\ud83d\udd14 NEW ORDER from SpiceRoute\nCustomer: {{ $json.name }}\nItems: {{ $json.items }}\nPhone: {{ $json.phone }}\nTotal: PKR {{ $json.total }}"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "Notify Owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        -100
      ],
      "id": "rest-notify-id"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v18.0/1268258293044883/messages",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "to",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "type",
              "value": "text"
            },
            {
              "name": "text",
              "value": "\u2705 Order placed at SpiceRoute! \ud83c\udf7d\ufe0f\nYour food is being prepared.\nDelivery: 30-45 minutes.\nThank you!"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "Customer Confirmed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        100
      ],
      "id": "rest-confirm-id"
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "days"
      },
      "name": "Wait 2 Days",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        600,
        300
      ],
      "id": "rest-wait-id"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v18.0/1268258293044883/messages",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "to",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "type",
              "value": "text"
            },
            {
              "name": "text",
              "value": "Hi {{ $json.name }}! Hope you enjoyed your meal. Want to order again? \ud83d\ude0a"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "Send Follow-Up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "id": "rest-followup-id"
    },
    {
      "parameters": {
        "responseCode": 200,
        "responseData": "{\"status\":\"received\",\"orderId\":\"pending\"}",
        "responseType": "json"
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        600,
        0
      ],
      "id": "939f0593-166b-4d8d-9503-ea35b235d647"
    }
  ],
